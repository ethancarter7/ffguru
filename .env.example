# Provides local-only credentials to Docker Compose; copy this file to .env before changing any defaults.

POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DUCKDB_ENDPOINT=minio:9000
MINIO_DUCKDB_UI_ENDPOINT=localhost:9000
BRONZE_BUCKET=bronze

AIRFLOW_IMAGE_NAME=ffguru-airflow:local
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=local-development-jwt-secret
